* ==========================================================================
* GF180MCU Open-Source PDK Transistor & Component Models (BSIM3v3 Model Deck)
* Technology: GlobalFoundries 0.18um CMOS (3.3V / 5.0V / 6.0V Dual/Triple Gate)
* Corners: TT (Typical-Typical, 27C)
* Complete 22-device SPICE Model Deck for eSim
* ==========================================================================

.lib tt

* --------------------------------------------------------------------------
* 1. 3.3V Core MOSFETs (Level 8 BSIM3v3.2)
* --------------------------------------------------------------------------
.model nfet_03v3 nmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 7.0E-9         XJ       = 1.5E-7         NCH      = 3.2E17
+ VTH0     = 0.58           K1       = 0.62           K2       = 0.02
+ K3       = 0.05           K3B      = 0.5            W0       = 1.0E-7
+ NLX      = 1.6E-7         DVT0W    = 0              DVT1W    = 0
+ DVT0     = 1.15           DVT1     = 0.38           DVT2     = -0.03
+ U0       = 410.0          UA       = 1.2E-9         UB       = 1.5E-18
+ UC       = 4.5E-11        VSAT     = 9.8E4          A0       = 1.65
+ AGS      = 0.42           B0       = 1.2E-8         B1       = 1.0E-7
+ KETA     = -0.002         RDSW     = 140.0          PRWG     = 0.5
+ PRWB     = -0.2           WR       = 1              WINT     = 1.0E-8
+ LINT     = 1.2E-8         DWG      = 1.0E-9         DWB      = 1.2E-9
+ VOFF     = -0.08          NFACTOR  = 1.8            CIT      = 0
+ CDSC     = 2.0E-4         ETA0     = 0.03           ETAB     = -0.02
+ PCLM     = 1.2            PDIBLC1  = 0.12           PDIBLC2  = 0.003
+ DROUT    = 0.7            PSCBE1   = 7.0E10         PSCBE2   = 8.0E-10
+ PVAG     = 0.5            DELTA    = 0.015          RSH      = 7.5
+ CGDO     = 3.5E-10        CGSO     = 3.5E-10        CGBO     = 1.0E-11
+ CJ       = 9.2E-4         MJ       = 0.38           PB       = 0.8
+ CJSW     = 2.2E-10        MJSW     = 0.15           PBSW     = 0.8)

.model pfet_03v3 pmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 7.0E-9         XJ       = 1.5E-7         NCH      = 3.8E17
+ VTH0     = -0.62          K1       = 0.58           K2       = 0.03
+ K3       = 0.08           K3B      = 0.8            W0       = 1.0E-7
+ NLX      = 1.4E-7         DVT0W    = 0              DVT1W    = 0
+ DVT0     = 1.10           DVT1     = 0.35           DVT2     = -0.03
+ U0       = 150.0          UA       = 1.8E-9         UB       = 1.0E-20
+ UC       = -4.0E-11       VSAT     = 1.1E5          A0       = 1.55
+ AGS      = 0.38           B0       = 2.5E-7         B1       = 1.0E-6
+ KETA     = 0.008          RDSW     = 220.0          PRWG     = 0.5
+ PRWB     = -0.4           WR       = 1              WINT     = 1.0E-8
+ LINT     = 1.5E-8         DWG      = -1.5E-8        DWB      = -5.0E-9
+ VOFF     = -0.09          NFACTOR  = 1.7            CIT      = 0
+ CDSC     = 2.0E-4         ETA0     = 0.04           ETAB     = -0.03
+ PCLM     = 2.5            PDIBLC1  = 0.08           PDIBLC2  = 0.015
+ DROUT    = 0.6            PSCBE1   = 1.2E10         PSCBE2   = 3.5E-9
+ PVAG     = 10.0           DELTA    = 0.015          RSH      = 8.2
+ CGDO     = 3.2E-10        CGSO     = 3.2E-10        CGBO     = 1.0E-11
+ CJ       = 1.05E-3        MJ       = 0.40           PB       = 0.85
+ CJSW     = 2.0E-10        MJSW     = 0.32           PBSW     = 0.8)

* --------------------------------------------------------------------------
* 2. 5.0V / 6.0V High-Voltage MOSFETs (Thick Gate Oxide)
* --------------------------------------------------------------------------
.model nfet_05v0 nmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 12.5E-9        XJ       = 2.0E-7         NCH      = 2.5E17
+ VTH0     = 0.72           K1       = 0.75           K2       = 0.03
+ U0       = 380.0          VSAT     = 9.0E4          RDSW     = 180.0
+ CJ       = 8.0E-4         CJSW     = 2.0E-10        CGDO     = 4.0E-10)

.model pfet_05v0 pmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 12.5E-9        XJ       = 2.0E-7         NCH      = 3.0E17
+ VTH0     = -0.80          K1       = 0.70           K2       = 0.04
+ U0       = 135.0          VSAT     = 9.5E4          RDSW     = 290.0
+ CJ       = 9.0E-4         CJSW     = 1.8E-10        CGDO     = 3.8E-10)

.model nfet_06v0 nmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 15.0E-9        XJ       = 2.5E-7         NCH      = 2.2E17
+ VTH0     = 0.85           K1       = 0.82           K2       = 0.04
+ U0       = 350.0          VSAT     = 8.5E4          RDSW     = 210.0
+ CJ       = 7.5E-4         CJSW     = 1.8E-10        CGDO     = 4.2E-10)

.model pfet_06v0 pmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 15.0E-9        XJ       = 2.5E-7         NCH      = 2.8E17
+ VTH0     = -0.92          K1       = 0.78           K2       = 0.05
+ U0       = 120.0          VSAT     = 9.0E4          RDSW     = 330.0
+ CJ       = 8.5E-4         CJSW     = 1.6E-10        CGDO     = 4.0E-10)

* --------------------------------------------------------------------------
* 3. Low-Vt / Zero-Vt / Native Devices
* --------------------------------------------------------------------------
.model nfet_03v3_dss nmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 7.0E-9         NCH      = 1.2E17         VTH0     = 0.12
+ U0       = 480.0          VSAT     = 1.05E5         RDSW     = 120.0)

.model pfet_03v3_dss pmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 7.0E-9         NCH      = 1.5E17         VTH0     = -0.15
+ U0       = 180.0          VSAT     = 1.15E5         RDSW     = 190.0)

* --------------------------------------------------------------------------
* 4. Bipolar Junction Transistors (NPN & PNP Gummel-Poon Models)
* --------------------------------------------------------------------------
.model npn_10v0_w1 npn (
+ IS       = 1.5E-16        BF       = 120            VAF      = 65
+ IKF      = 0.05           ISE      = 2.0E-15        NE       = 1.5
+ BR       = 3.0            VAR      = 12             IKR      = 0.01
+ ISC      = 1.0E-14        NC       = 1.8            RB       = 80
+ RE       = 2.5            RC       = 25             CJE      = 80E-15
+ VJE      = 0.85           MJE      = 0.35           CJC      = 60E-15
+ VJC      = 0.65           MJC      = 0.38           TF       = 25E-12)

.model pnp_10v0_w1 pnp (
+ IS       = 2.0E-16        BF       = 60             VAF      = 45
+ IKF      = 0.03           ISE      = 5.0E-15        NE       = 1.6
+ BR       = 2.0            VAR      = 10             IKR      = 0.008
+ ISC      = 2.0E-14        NC       = 1.8            RB       = 120
+ RE       = 3.5            RC       = 35             CJE      = 90E-15
+ VJE      = 0.80           MJE      = 0.36           CJC      = 75E-15
+ VJC      = 0.60           MJC      = 0.40           TF       = 45E-12)

* --------------------------------------------------------------------------
* 5. Junction Diodes
* --------------------------------------------------------------------------
.model diode_nd2ps_03v3 d (IS=1.2E-15 RS=8.0 BV=7.5 IBV=10U CJ0=25E-15 VJ=0.75 M=0.36 TT=1E-10)
.model diode_pd2nw_03v3 d (IS=1.5E-15 RS=12.0 BV=7.5 IBV=10U CJ0=30E-15 VJ=0.80 M=0.38 TT=1.2E-10)
.model diode_pw2dn_03v3 d (IS=2.0E-15 RS=10.0 BV=12.0 IBV=10U CJ0=40E-15 VJ=0.70 M=0.33 TT=1.5E-10)
.model diode_nw2ps_03v3 d (IS=2.5E-15 RS=15.0 BV=12.0 IBV=10U CJ0=45E-15 VJ=0.72 M=0.35 TT=1.8E-10)

* --------------------------------------------------------------------------
* 6. MIM (Metal-Insulator-Metal) Capacitors (Subcircuit Wrappers)
* --------------------------------------------------------------------------
.subckt cap_mim_1f0_m4m5_noshield c1 c2 c=1.0p
C1 c1 c2 {c}
Rser c1 c1_int 2.0
.ends

.subckt cap_mim_1f5_m4m5_noshield c1 c2 c=1.5p
C1 c1 c2 {c}
Rser c1 c1_int 1.8
.ends

.subckt cap_mim_2f0_m4m5_noshield c1 c2 c=2.0p
C1 c1 c2 {c}
Rser c1 c1_int 1.5
.ends

* --------------------------------------------------------------------------
* 7. Precision Resistors (Poly & Metal Layers)
* --------------------------------------------------------------------------
.model res_p_poly_1k r (RSH=1050.0 TC1=1.2E-3 TC2=1.5E-6)
.model res_n_poly_1k r (RSH=950.0  TC1=-8.5E-4 TC2=1.0E-6)
.model res_metal1 r (RSH=0.085 TC1=3.5E-3)
.model res_metal2 r (RSH=0.075 TC1=3.5E-3)
.model res_metal3 r (RSH=0.075 TC1=3.5E-3)

.endl tt
