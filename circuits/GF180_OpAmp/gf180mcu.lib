* ==========================================================================
* GF180MCU Open-Source PDK Transistor Models (BSIM3v3 Compact Model Deck)
* Technology: GlobalFoundries 0.18um CMOS (3.3V / 5.0V Dual Gate)
* Corners: TT (Typical-Typical, 27C)
* ==========================================================================

.lib tt
* 3.3V NMOS Transistor (Level 8 BSIM3v3.2)
.model nfet_03v3 nmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 7.0E-9         XJ       = 1.5E-7         NCH      = 3.2E17
+ VTH0     = 0.58           K1       = 0.62           K2       = 0.02
+ K3       = 0.05           K3B      = 0.5            W0       = 1.0E-7
+ NLX      = 1.6E-7         DVT0W    = 0              DVT1W    = 0
+ DVT0     = 1.15           DVT1     = 0.38           DVT2     = -0.03
+ U0       = 410.0          UA       = 1.2E-9         UB       = 1.5E-18
+ UC       = 4.5E-11        VSAT     = 9.8E4          A0       = 1.65
+ AGS      = 0.42           B0       = 1.2E-8         B1       = 1.0E-7
+ KETA     = -0.002         RDSW     = 140.0          PRWG     = 0.5
+ PRWB     = -0.2           WR       = 1              WINT     = 1.0E-8
+ LINT     = 1.2E-8         DWG      = 1.0E-9         DWB      = 1.2E-9
+ VOFF     = -0.08          NFACTOR  = 1.8            CIT      = 0
+ CDSC     = 2.0E-4         ETA0     = 0.03           ETAB     = -0.02
+ PCLM     = 1.2            PDIBLC1  = 0.12           PDIBLC2  = 0.003
+ DROUT    = 0.7            PSCBE1   = 7.0E10         PSCBE2   = 8.0E-10
+ PVAG     = 0.5            DELTA    = 0.015          RSH      = 7.5
+ CGDO     = 3.5E-10        CGSO     = 3.5E-10        CGBO     = 1.0E-11
+ CJ       = 9.2E-4         MJ       = 0.38           PB       = 0.8
+ CJSW     = 2.2E-10        MJSW     = 0.15           PBSW     = 0.8)

* 3.3V PMOS Transistor (Level 8 BSIM3v3.2)
.model pfet_03v3 pmos (
+ LEVEL    = 8              VERSION  = 3.2            TNOM     = 27
+ TOX      = 7.0E-9         XJ       = 1.5E-7         NCH      = 3.8E17
+ VTH0     = -0.62          K1       = 0.58           K2       = 0.03
+ K3       = 0.08           K3B      = 0.8            W0       = 1.0E-7
+ NLX      = 1.4E-7         DVT0W    = 0              DVT1W    = 0
+ DVT0     = 1.10           DVT1     = 0.35           DVT2     = -0.03
+ U0       = 150.0          UA       = 1.8E-9         UB       = 1.0E-20
+ UC       = -4.0E-11       VSAT     = 1.1E5          A0       = 1.55
+ AGS      = 0.38           B0       = 2.5E-7         B1       = 1.0E-6
+ KETA     = 0.008          RDSW     = 220.0          PRWG     = 0.5
+ PRWB     = -0.4           WR       = 1              WINT     = 1.0E-8
+ LINT     = 1.5E-8         DWG      = -1.5E-8        DWB      = -5.0E-9
+ VOFF     = -0.09          NFACTOR  = 1.7            CIT      = 0
+ CDSC     = 2.0E-4         ETA0     = 0.04           ETAB     = -0.03
+ PCLM     = 2.5            PDIBLC1  = 0.08           PDIBLC2  = 0.015
+ DROUT    = 0.6            PSCBE1   = 1.2E10         PSCBE2   = 3.5E-9
+ PVAG     = 10.0           DELTA    = 0.015          RSH      = 8.2
+ CGDO     = 3.2E-10        CGSO     = 3.2E-10        CGBO     = 1.0E-11
+ CJ       = 1.05E-3        MJ       = 0.40           PB       = 0.85
+ CJSW     = 2.0E-10        MJSW     = 0.32           PBSW     = 0.8)
.endl tt
